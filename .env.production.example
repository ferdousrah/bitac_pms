# ────────────────────────────────────────────────────────────────────────────
# BITAC PMS — Production environment template
# Set these in Coolify → Application → Environment Variables.
# Never commit a real .env to git.
# ────────────────────────────────────────────────────────────────────────────

APP_NAME="BITAC PMS"
APP_ENV=production
APP_KEY=                                 # Coolify will set this (php artisan key:generate)
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://pms.example.com          # ← your real domain

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── Database (MySQL service inside Coolify) ──
DB_CONNECTION=mysql
DB_HOST=mysql                            # Coolify service name
DB_PORT=3306
DB_DATABASE=bitac_pms
DB_USERNAME=bitac
DB_PASSWORD=                             # ← set a strong password in Coolify

# ── Cache / Session / Queue ──
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=null

# Filesystem
FILESYSTEM_DISK=public

# ── AI (optional — leave blank to keep AI disabled) ──
GEMINI_API_KEY=

# ── Pusher (optional, for real-time broadcasting) ──
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=ap2

# ── Mail (configure if you want email notifications) ──
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
